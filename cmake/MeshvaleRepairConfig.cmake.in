@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@MESHVALE_REPAIR_GLTF_WORKFLOW@ OR @MESHVALE_REPAIR_OFF_FILE_WORKFLOW@
   OR @MESHVALE_REPAIR_PLY_FILE_WORKFLOW@ OR @MESHVALE_REPAIR_OFF_SURFACE_EXPORT@)
  find_dependency(MeshvaleInterchange 0.0.0 EXACT CONFIG)
endif()
find_dependency(MeshvaleGeometry 0.0.0 EXACT CONFIG)
if(@MESHVALE_REPAIR_MATERIALIZED_DUPLICATES@)
  find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MeshvaleRepairTargets.cmake")
check_required_components(MeshvaleRepair)
