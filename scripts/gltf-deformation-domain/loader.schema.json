{
  "type": "object",
  "properties": {
    "schema": {
      "const": "meshvale.gltf-deformation-test-loader/1"
    },
    "module_name": {
      "const": "meshvale_repair._repair"
    },
    "spec_name": {
      "const": "meshvale_repair._repair"
    },
    "module_file": {
      "type": "string"
    },
    "spec_origin": {
      "type": "string"
    },
    "sys_prefix": {
      "type": "string"
    },
    "before_import": {
      "$ref": "#/$defs/artifact"
    },
    "after_import": {
      "$ref": "#/$defs/artifact"
    },
    "wheel_member": {
      "$ref": "#/$defs/artifact"
    },
    "python_executable": {
      "$ref": "#/$defs/artifact"
    },
    "python_version": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "module_name",
    "spec_name",
    "module_file",
    "spec_origin",
    "sys_prefix",
    "before_import",
    "after_import",
    "wheel_member",
    "python_executable",
    "python_version"
